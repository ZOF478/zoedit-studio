node_modules/
dashboard/node_modules/
dashboard/dist/

# Local environment files (never commit real secrets)
.env
.env.*
!.env.example

# Runtime data and generated artifacts
dashboard/data/*
!dashboard/data/.gitkeep
out/*
build/*
public/audio/*
!public/audio/.gitkeep
public/user-assets/*
!public/user-assets/.gitkeep
*.log
.zoedit_*

# Never commit user settings or API keys (they live in ~/.zoedit-studio)
**/studio-settings.json
**/.zoedit-studio/

# Secrets, local config, and temp caches
.npmrc
*.pem
*.key
*.p12
*.tsbuildinfo
.DS_Store
**/.cache/
**/*.tmp

# Media artifacts
*.mp4
*.wav
*.mp3
!public/sfx/*.wav
