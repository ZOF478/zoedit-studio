# Root environment example for Zoedit Studio.
# Copy to `.env` and replace the placeholders with your own values.
# Never commit a real `.env` file.

# Server binding (defaults to local-only and are usually fine)
PORT=4789
HOST=127.0.0.1
REMOTION_STUDIO_PORT=3333

# AI providers
GEMINI_API_KEY="your_api_key_here"
OPENROUTER_API_KEY="your_api_key_here"
DEEPSEEK_API_KEY="your_api_key_here"
KIEAI_API_KEY="your_api_key_here"

# ElevenLabs text-to-speech (optional; Edge TTS and Piper need no key)
ELEVENLABS_API_KEY="your_api_key_here"

# Optional: use an existing Piper binary instead of the auto-downloaded runtime.
# PIPER_BIN="/usr/local/bin/piper"

# Public app URL
APP_URL="http://localhost:4789"
