{
  "name": "zoedit-studio",
  "version": "1.3.1",
  "description": "AI-directed, custom-coded motion graphics studio built on React and Remotion.",
  "keywords": [
    "remotion",
    "motion-graphics",
    "video",
    "react",
    "ai",
    "text-to-speech",
    "captions",
    "tiktok",
    "reels",
    "shorts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZOF478/zoedit-studio.git"
  },
  "homepage": "https://studio.zoedit.com",
  "bugs": {
    "url": "https://github.com/ZOF478/zoedit-studio/issues"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": false,
  "bin": {
    "zoedit-studio": "./bin/zoedit-studio.mjs"
  },
  "dependencies": {
    "@iconify/react": "^6.0.4",
    "@remotion/cli": "4.0.545",
    "@remotion/google-fonts": "4.0.545",
    "@remotion/noise": "^4.0.545",
    "@remotion/paths": "^4.0.545",
    "@remotion/shapes": "^4.0.545",
    "@remotion/transitions": "^4.0.545",
    "colord": "^2.14.0",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "lucide-react": "^1.77.0",
    "opencode-ai": "latest",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545",
    "roughjs": "^4.6.6",
    "simple-icons": "^16.38.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.545",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "start": "node ./bin/zoedit-studio.mjs",
    "postinstall": "node ./scripts/postinstall.mjs",
    "setup": "npm install && npm --prefix dashboard install --legacy-peer-deps && (npm link || node ./bin/link-fallback.mjs)",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
