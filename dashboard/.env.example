# Dashboard environment example for Zof Studio.
# Copy to `dashboard/.env` and replace the placeholders with your own values.
# Never commit a real `.env` file.

# GEMINI_API_KEY: Optional fallback for Gemini AI script generation.
GEMINI_API_KEY="your_api_key_here"

# OPENROUTER_API_KEY: Server-side key for OpenRouter script generation models.
OPENROUTER_API_KEY="your_api_key_here"

# ELEVENLABS_API_KEY: Server-side key for ElevenLabs voices, models, and TTS.
ELEVENLABS_API_KEY="your_api_key_here"

# DEEPSEEK_API_KEY: Direct DeepSeek API key (also auto-detected from OpenCode auth.json).
DEEPSEEK_API_KEY="your_api_key_here"

# KIEAI_API_KEY: Kie.ai API key for OpenAI-compatible chat completions.
KIEAI_API_KEY="your_api_key_here"

# PORT / HOST: Dashboard binding. Keep HOST local-only unless you know why.
PORT=4789
HOST=127.0.0.1

# REMOTION_STUDIO_PORT: Port for the embedded Remotion Studio preview.
REMOTION_STUDIO_PORT=3333

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:4789"
