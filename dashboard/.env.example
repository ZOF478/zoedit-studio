# GEMINI_API_KEY: Optional fallback for Gemini AI script generation.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Server-side key for OpenRouter script generation models.
OPENROUTER_API_KEY=""

# ELEVENLABS_API_KEY: Server-side key for ElevenLabs voices, models, and TTS.
ELEVENLABS_API_KEY=""

# PORT: Server port for the local Zof Studio dashboard (bound to 127.0.0.1 only).
PORT=4789

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DEEPSEEK_API_KEY: Direct DeepSeek API key (also auto-detected from OpenCode auth.json).
DEEPSEEK_API_KEY=""

# KIEAI_API_KEY: Kie.ai API key for OpenAI-compatible chat completions.
KIEAI_API_KEY=""
